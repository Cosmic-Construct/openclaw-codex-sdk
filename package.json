{
  "name": "openclaw-codex-sdk",
  "version": "2026.5.1",
  "description": "OpenClaw ACP runtime backend powered by the official Codex SDK",
  "license": "MIT",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "RELEASE.md",
    "index.ts",
    "openclaw.plugin.json",
    "src",
    "!src/*.test.ts",
    "!src/test-helpers.ts"
  ],
  "scripts": {
    "test": "vitest run src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "openclaw",
    "codex",
    "codex-sdk",
    "acp",
    "mcp",
    "clawhub",
    "agent-runtime"
  ],
  "homepage": "https://github.com/Cosmic-Construct/openclaw-codex-sdk#readme",
  "bugs": {
    "url": "https://github.com/Cosmic-Construct/openclaw-codex-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cosmic-Construct/openclaw-codex-sdk.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@openai/codex-sdk": "0.128.0",
    "ws": "8.19.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.29"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "openclaw": "2026.4.29",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.4.29",
      "minGatewayVersion": ">=2026.4.29"
    },
    "build": {
      "openclawVersion": "2026.4.29",
      "pluginSdkVersion": "2026.4.29"
    }
  }
}
